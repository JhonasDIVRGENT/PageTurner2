<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jhonas.pageturner2.ui.LibroController"
      spacing="20"
      styleClass="panel">

    <Label text="Libros" styleClass="titulo-seccion"/>

    <VBox styleClass="tarjeta" spacing="0" VBox.vgrow="ALWAYS">
        <TableView fx:id="tablaLibros" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colTitulo" text="Título" prefWidth="240"/>
                <TableColumn fx:id="colAutor" text="Autor" prefWidth="190"/>
                <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="120"/>
                <TableColumn fx:id="colPrecio" text="Precio" prefWidth="100"/>
                <TableColumn fx:id="colStock" text="Stock" prefWidth="90"/>
            </columns>
            <placeholder>
                <Label text="Aún no hay libros registrados"/>
            </placeholder>
        </TableView>
    </VBox>

    <VBox styleClass="tarjeta" spacing="14">
        <Label text="Registrar nuevo libro" styleClass="tarjeta-titulo"/>

        <HBox spacing="10">
            <TextField fx:id="campoTitulo" promptText="Título" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="campoAutor" promptText="Autor" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="campoIsbn" promptText="ISBN" prefWidth="130"/>
            <TextField fx:id="campoPrecio" promptText="Precio" prefWidth="110"/>
            <TextField fx:id="campoStock" promptText="Stock" prefWidth="100"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER">
            <Button text="Añadir libro" onAction="#guardarLibro" styleClass="boton-accion-grande"/>
            <Button text="Eliminar seleccionado" onAction="#eliminarLibro" styleClass="boton-secundario-grande"/>
        </HBox>

        <Label fx:id="mensaje"/>
    </VBox>

</VBox>